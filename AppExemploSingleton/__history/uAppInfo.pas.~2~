unit uAppInfo;

interface

  {---------------------------------------------
   Informações básicas do aplicativo
  ---------------------------------------------}
type
  TAppInfo = class
  private
    FNome: string;
    FVersao: string;
  public
    constructor Create;
    property Nome: string read FNome write FNome;
    property Versao: string read FVersao write FVersao;
  end;

implementation

{ TAppInfo }

constructor TAppInfo.Create;
begin
  inherited Create;
  FNome := 'MeuApp';
  FVersao := '1.0.0';
end;

end.

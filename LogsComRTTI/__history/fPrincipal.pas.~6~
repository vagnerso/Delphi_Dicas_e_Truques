unit fPrincipal;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls, System.Rtti;

type
  TPessoa = class
  private
    FNome: string;
    FIdade: Integer;
  public
    property Nome: string read FNome write FNome;
    property Idade: Integer read FIdade write FIdade;
  end;

type
  TfrmPrincipal = class(TForm)
    Edit1: TEdit;
    Edit2: TEdit;
    btnGravarLogs: TButton;
    Panel1: TPanel;
    Panel2: TPanel;
    Label1: TLabel;
    Label2: TLabel;
  private
    procedure GravarLogErro(Obj: TObject; const MsgErro: string);
    { Private declarations }

  public
    { Public declarations }
  end;

var
  frmPrincipal: TfrmPrincipal;

implementation

uses
  System.TypInfo;

{$R *.dfm}

{ TfrmPrincipal }

procedure TfrmPrincipal.GravarLogErro(Obj: TObject; const MsgErro: string);
var
  Contexto: TRttiContext;
  Tipo: TRttiType;
  Prop: TRttiProperty;
  Log: TStringList;
begin
  Log := TStringList.Create;
  try
    Log.Add('Erro: ' + MsgErro);
    Log.Add('Classe: ' + Obj.ClassName);
    Log.Add('Data/Hora: ' + DateTimeToStr(Now));
    Log.Add('--- Propriedades ---');

    Tipo := Contexto.GetType(Obj.ClassType);

    for Prop in Tipo.GetProperties do
      if (Prop.Visibility = mvPublished) and (Prop.IsReadable) then
        Log.Add(Prop.Name + ' = ' + Prop.GetValue(Obj).ToString);

    Log.SaveToFile('ErroLog.txt', TEncoding.UTF8);
  finally
    Log.Free;
  end;
end;

end.

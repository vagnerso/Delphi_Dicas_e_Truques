unit fPrincipal;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Vcl.WinXCtrls,
  Vcl.StdCtrls, IniFiles;

type
  TfrmPrincipal = class(TForm)
    pnlTitulo: TPanel;
    Panel1: TPanel;
    Panel2: TPanel;
    edtCaminhoBanco: TEdit;
    Label1: TLabel;
    Label2: TLabel;
    edtNumeroVias: TEdit;
    ToggleSwitch1: TToggleSwitch;
    Label3: TLabel;
    Button1: TButton;
    procedure Button1Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmPrincipal: TfrmPrincipal;

implementation

{$R *.dfm}

procedure TfrmPrincipal.Button1Click(Sender: TObject);
var
  lIniFile: TIniFile;
begin

  try

    lIniFile := TIniFile.Create(ExtractFilePath(Application.exeName) + '\configuracoes.ini');
    try

      lIniFile.WriteString('Database', 'Path', edtCaminhoBanco.Text);
      lIniFile.WriteInteger('Printer', 'Vias', StrToIntDef(edtNumeroVias.Text, 1));

      if ToggleSwitch1.State = TToggleSwitchState.tssOn then
      begin
        lIniFile.WriteBool('Product', 'Price', True);
      end
      else
      begin
        lIniFile.WriteBool('Product', 'Price', False);
      end;

    finally
      lIniFile.Free;
    end;

  except on E: Exception do
    ShowMessage('Erro ao tentar salvar arquivo ini de configurações!' + sLineBreak +
    E.Message);
  end;

end;

end.
